# ==============================================================================
# PROJECT & ENVIRONMENT CONFIGURATION
# ==============================================================================
# Change PROJECT_NAME when copying this codebase for another app.
# It automatically namespaces Docker containers, networks, volumes, Redis keys & JWT.
PROJECT_NAME=umi
NODE_ENV=production
CLIENT_URL=*

# ==============================================================================
# DOCKER & PORT MAPPINGS (HOST PORTS)
# ==============================================================================
# Change these ports if running multiple apps on the same server to avoid collisions.
BACKEND_PORT=5050
ADMIN_PORT=3000
MYSQL_PORT=3306
REDIS_PORT=6379

# ==============================================================================
# MYSQL DATABASE CONFIGURATION
# ==============================================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=umi_live
DB_USER=umi_user
DB_PASSWORD=umi_password
MYSQL_ROOT_PASSWORD=root_secure_password_2026
DB_CONNECTION_LIMIT=20
DB_QUEUE_LIMIT=0
DB_ENABLE_KEEP_ALIVE=true
DB_KEEP_ALIVE_DELAY=10000

# ==============================================================================
# REDIS IN-MEMORY CACHE (PRODUCTION-GRADE)
# ==============================================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=umi:
REDIS_MAX_MEMORY=256mb
REDIS_MAX_MEMORY_POLICY=allkeys-lru
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=2500
REDIS_DEFAULT_TTL=180
REDIS_MIN_TTL=5
REDIS_MAX_TTL=3600

# Section-Specific Redis Cache TTLs (Seconds)
REDIS_TTL_LIVE_STREAM=10
REDIS_TTL_WALLET=20
REDIS_TTL_NOTIFICATIONS=20
REDIS_TTL_LEADERBOARD=60
REDIS_TTL_USER_PROFILE=60
REDIS_TTL_RESELLER_AGENCY=60
REDIS_TTL_ECONOMY_CONFIG=30
REDIS_TTL_CATALOG=300
REDIS_TTL_SYSTEM_CONFIG=300
REDIS_TTL_SECURITY_OTP=300
REDIS_TTL_SECURITY_BAN=604800
REDIS_TTL_CHAT=20
REDIS_TTL_FEED=45

# ==============================================================================
# JWT AUTHENTICATION
# ==============================================================================
JWT_SECRET=umi_live_jwt_secret_token_key_2026_super_secure!
JWT_EXPIRES_IN=7d
JWT_ISSUER=umi

# ==============================================================================
# SOCKET.IO WEBSOCKETS
# ==============================================================================
SOCKET_CORS_ORIGIN=*
SOCKET_PING_TIMEOUT=30000
SOCKET_PING_INTERVAL=25000
SOCKET_MAX_BUFFER_SIZE=10485760
HOST_DISCONNECT_GRACE_PERIOD_SECONDS=90
GUEST_SEAT_DISCONNECT_GRACE_PERIOD_SECONDS=60

# ==============================================================================
# LIVEKIT WEBRTC VIDEO & AUDIO STREAMING
# ==============================================================================
LIVEKIT_URL=wss://sp-live-77aj0nb6.livekit.cloud
LIVEKIT_API_KEY=API8RXeTebwtkfg
LIVEKIT_API_SECRET=G9lYenZnHxa5FUiXvkFBDa5n1a6WUq7hJecNA5OS8I0

# ==============================================================================
# FIREBASE CLOUD MESSAGING (PUSH NOTIFICATIONS)
# ==============================================================================
FIREBASE_CREDENTIALS_PATH=./umi_firebase.json

# ==============================================================================
# ADMIN PANEL (VITE FRONTEND)
# ==============================================================================
VITE_API_BASE_URL=http://localhost:5050/api
VITE_SOCKET_URL=http://localhost:5050
VITE_LIVEKIT_URL=wss://sp-live-77aj0nb6.livekit.cloud
VITE_APP_TITLE=UMI LIVE ADMIN

# ==============================================================================
# AUTH SECURITY & BRUTE-FORCE DEFENSE
# ==============================================================================
LOGIN_MAX_FAILED_PER_ACCOUNT=5
LOGIN_MAX_FAILED_PER_IP=10
LOGIN_LOCKOUT_MINUTES=15
LOGIN_WINDOW_MINUTES=15

# ==============================================================================
# LIVE ROOM SCALE GUARDS (large audiences)
# ==============================================================================
# Rooms up to this many viewers keep announcing every join/leave; bigger rooms are rate-limited
LIVE_FULL_ANNOUNCE_MAX_VIEWERS=100
LIVE_JOIN_ANNOUNCE_PER_SEC=5
LIVE_ENTRY_EFFECT_PER_SEC=3
# viewer_count recount (COUNT + UPDATE) at most once per window per room
LIVE_VIEWER_SYNC_WINDOW_MS=1500
# viewer-count-update to the room / room_stats_update to home feed, at most once per window
LIVE_VIEWER_EMIT_WINDOW_MS=1000
LIVE_STATS_EMIT_WINDOW_MS=3000
LIVE_CACHE_INVALIDATE_WINDOW_MS=2000
# Per-socket chat limit: sustained msgs/sec and burst
LIVE_CHAT_PER_SEC=1.5
LIVE_CHAT_BURST=4
# Redis TTL (seconds) for cached chat profile / equipped entry effect
LIVE_PROFILE_CACHE_TTL=30

# ==============================================================================
# HORIZONTAL SCALING, RATE LIMITING, OBSERVABILITY
# ==============================================================================
# One worker per CPU core via PM2 (requires Redis). false = single `node src/server.js`
CLUSTER_MODE=false
PM2_INSTANCES=max
# MUST be true when more than one process/machine runs (shares socket rooms through Redis)
SOCKET_REDIS_ADAPTER=false
SOCKET_ADAPTER_REQUEST_TIMEOUT_MS=3000
# How many reverse-proxy hops to trust for the real client IP: a number (1 = one LB/nginx hop)
# or a list like "loopback, 10.0.0.0/8". Empty = loopback + private ranges (docker/nginx).
TRUST_PROXY=
# Prometheus /metrics: if set, scrapers must send "Authorization: Bearer <token>".
# If empty, only private/loopback peers may scrape.
METRICS_TOKEN=
# Graceful shutdown: wait for LB to stop routing (readiness=503), then close, force-exit after FORCE.
SHUTDOWN_DRAIN_MS=5000
SHUTDOWN_FORCE_MS=20000
# Rate limits (requests per minute). Per-IP limits stay generous: carrier NAT shares one IP between many users.
RATE_LIMIT_GLOBAL_IP_PER_MIN=3000
RATE_LIMIT_USER_PER_MIN=600
RATE_LIMIT_AUTH_PER_MIN=60
RATE_LIMIT_MONEY_PER_MIN=120
RATE_LIMIT_LIVE_ACTION_PER_MIN=90
RATE_LIMIT_UPLOAD_PER_MIN=30
# Per-socket default event budget (events/sec, burst). Specific events have tighter built-in limits.
LIVE_SOCKET_DEFAULT_EVENTS_PER_SEC=40
LIVE_SOCKET_DEFAULT_EVENT_BURST=80

# ==============================================================================
# PHASE 2: BIG-ROOM FAN-OUT, READ REPLICA
# ==============================================================================
# The settings below can ALSO be changed live (no restart/app release) from the admin panel
# system settings: live_frames_enabled, live_frame_threshold_viewers, live_frame_interval_ms,
# live_chat_room_max_per_sec, live_chat_legacy_max_per_sec, live_reaction_legacy_max_per_sec,
# live_disable_join_announce, live_disable_entry_effect, live_disable_reactions  (admin value wins).
LIVE_FRAMES_ENABLED=true
LIVE_FRAME_THRESHOLD_VIEWERS=150
LIVE_FRAME_INTERVAL_MS=250
LIVE_CHAT_ROOM_MAX_PER_SEC=25
LIVE_CHAT_LEGACY_MAX_PER_SEC=8
LIVE_REACTION_LEGACY_MAX_PER_SEC=6
LIVE_DISABLE_JOIN_ANNOUNCE=false
LIVE_DISABLE_ENTRY_EFFECT=false
LIVE_DISABLE_REACTIONS=false
# Optional MySQL read replica for list/feed reads (queryRead). Unset = use the primary.
DB_READ_HOST=
DB_READ_PORT=3306
DB_READ_USER=
DB_READ_PASSWORD=
DB_READ_CONNECTION_LIMIT=20

# ==============================================================================
# SEAT RACE GUARD (per-room lock, cluster-wide via Redis)
# ==============================================================================
# Every state-changing seat/room request is serialised per room. A request waits up to WAIT for its
# turn, otherwise it gets HTTP 503 {code:"room_busy"} (the app should retry after ~1s).
ROOM_LOCK_TTL_MS=8000
ROOM_LOCK_WAIT_MS=5000
ROOM_LOCK_MAX_HOLD_MS=30000

