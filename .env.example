# ==============================================================================
# PROJECT & ENVIRONMENT CONFIGURATION
# ==============================================================================
# Change PROJECT_NAME when copying this codebase for another app.
# It automatically namespaces Docker containers, networks, volumes, Redis keys & JWT.
PROJECT_NAME=umi
NODE_ENV=production
CLIENT_URL=*

# ==============================================================================
# DOCKER & PORT MAPPINGS (HOST PORTS)
# ==============================================================================
# Change these ports if running multiple apps on the same server to avoid collisions.
BACKEND_PORT=5050
ADMIN_PORT=3000
MYSQL_PORT=3306
REDIS_PORT=6379

# ==============================================================================
# MYSQL DATABASE CONFIGURATION
# ==============================================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=umi_live
DB_USER=umi_user
DB_PASSWORD=umi_password
MYSQL_ROOT_PASSWORD=root_secure_password_2026
DB_CONNECTION_LIMIT=20
DB_QUEUE_LIMIT=0
DB_ENABLE_KEEP_ALIVE=true
DB_KEEP_ALIVE_DELAY=10000

# ==============================================================================
# REDIS IN-MEMORY CACHE (PRODUCTION-GRADE)
# ==============================================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=umi:
REDIS_MAX_MEMORY=256mb
REDIS_MAX_MEMORY_POLICY=allkeys-lru
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=2500
REDIS_DEFAULT_TTL=300
REDIS_MIN_TTL=5
REDIS_MAX_TTL=3600

# ==============================================================================
# JWT AUTHENTICATION
# ==============================================================================
JWT_SECRET=umi_live_jwt_secret_token_key_2026_super_secure!
JWT_EXPIRES_IN=7d
JWT_ISSUER=umi

# ==============================================================================
# SOCKET.IO WEBSOCKETS
# ==============================================================================
SOCKET_CORS_ORIGIN=*
SOCKET_PING_TIMEOUT=30000
SOCKET_PING_INTERVAL=25000
SOCKET_MAX_BUFFER_SIZE=10485760
HOST_DISCONNECT_GRACE_PERIOD_SECONDS=90
GUEST_SEAT_DISCONNECT_GRACE_PERIOD_SECONDS=60

# ==============================================================================
# LIVEKIT WEBRTC VIDEO & AUDIO STREAMING
# ==============================================================================
LIVEKIT_URL=wss://snlive-y3r75itj.livekit.cloud
LIVEKIT_API_KEY=APInTHjZ4pwntq4
LIVEKIT_API_SECRET=euPgL1zVA1nD0GeorSxn9amK7PayQg0nnoliE4e9xWlB

# ==============================================================================
# FIREBASE CLOUD MESSAGING (PUSH NOTIFICATIONS)
# ==============================================================================
FIREBASE_CREDENTIALS_PATH=./umi_firebase.json

# ==============================================================================
# ADMIN PANEL (VITE FRONTEND)
# ==============================================================================
VITE_API_BASE_URL=http://localhost:5050/api
VITE_SOCKET_URL=http://localhost:5050
VITE_LIVEKIT_URL=wss://snlive-y3r75itj.livekit.cloud
VITE_APP_TITLE=UMI LIVE ADMIN

# ==============================================================================
# AUTH SECURITY & BRUTE-FORCE DEFENSE
# ==============================================================================
LOGIN_MAX_FAILED_PER_ACCOUNT=5
LOGIN_MAX_FAILED_PER_IP=10
LOGIN_LOCKOUT_MINUTES=15
LOGIN_WINDOW_MINUTES=15


