# Standalone Backend Local Environment
PROJECT_NAME=umi
PORT=5050
NODE_ENV=development
CLIENT_URL=*

# MySQL Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=umi_user
DB_PASSWORD=umi_password
DB_NAME=umi_live
DB_CONNECTION_LIMIT=20

# Redis Cache
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=umi:

# JWT
JWT_SECRET=umi_live_jwt_secret_token_key_2026_super_secure!
JWT_EXPIRES_IN=7d
JWT_ISSUER=umi

# Socket.IO
SOCKET_CORS_ORIGIN=*
SOCKET_PING_TIMEOUT=30000
SOCKET_PING_INTERVAL=25000
SOCKET_MAX_BUFFER_SIZE=10485760

# Firebase Cloud Messaging (FCM)
FIREBASE_CREDENTIALS_PATH=../umi_firebase.json

# Live Streaming & Reconnection Settings
HOST_DISCONNECT_GRACE_PERIOD_SECONDS=0
APP_SHARE_URL=https://umilive.app

